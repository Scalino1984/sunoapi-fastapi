+def _ensure_wav_stem_source(source: Path, work_dir: Path, kind: str) -> Path:
+    """Liefert eine echte WAV-Datei, unabhängig vom Remote-Ausgabeformat."""
+    try:
+        with source.open("rb") as handle:
+            header = handle.read(12)
+    except OSError as exc:
+        raise RuntimeError(f"{kind}-Stem konnte nicht gelesen werden: {exc}") from exc
+    if source.suffix.lower() == ".wav" and header[:4] == b"RIFF" and header[8:12] == b"WAVE":
+        return source
+    ffmpeg = shutil.which("ffmpeg")
+    if not ffmpeg:
+        raise RuntimeError(f"{kind}-Stem liegt nicht als WAV vor und ffmpeg ist für die Konvertierung nicht verfügbar.")
+    target = work_dir / f"normalized_{kind}.wav"
+    completed = subprocess.run(
+        [
+            ffmpeg,
+            "-nostdin",
+            "-hide_banner",
+            "-loglevel",
+            "error",
+            "-y",
+            "-i",
+            str(source),
+            "-vn",
+            "-acodec",
+            "pcm_s16le",
+            "-ar",
+            "44100",
+            "-ac",
+            "2",
+            str(target),
+        ],
+        capture_output=True,
+        text=True,
+        timeout=60 * 20,
+    )
+    if completed.returncode != 0 or not target.exists() or target.stat().st_size <= 0:
+        detail = (completed.stderr or completed.stdout or "Stem-Konvertierung fehlgeschlagen.").strip()[-1200:]
+        raise RuntimeError(detail)
+    return target
+
