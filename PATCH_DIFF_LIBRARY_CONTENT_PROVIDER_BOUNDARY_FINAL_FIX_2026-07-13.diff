+def _is_provider_placeholder_payload(payload: Any) -> bool:
+    if not isinstance(payload, dict):
+        return False
+    message = str(payload.get("message") or payload.get("msg") or "").strip().lower()
+    if "missing authentication token" in message:
+        return True
