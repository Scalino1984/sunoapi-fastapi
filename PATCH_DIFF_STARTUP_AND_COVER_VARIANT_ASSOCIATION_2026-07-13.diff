+def _cover_media_id(value: Any) -> str | None:
+    """Extrahiert eine eindeutig erkennbare Suno-Medien-ID aus Cover-URLs.
+
+    Die Zuordnung wird ausschließlich zur Variantenabgrenzung verwendet. Eine
+    URL ohne erkennbare UUID bleibt zulässig, wird aber nicht als Beweis für
+    die Zugehörigkeit zu einer bestimmten Suno-Variante behandelt.
