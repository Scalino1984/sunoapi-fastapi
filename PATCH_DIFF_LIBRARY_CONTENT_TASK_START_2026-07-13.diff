+async def run_library_content_cache_task(task_id: int, limit: int = 5000) -> None:
+    """Fuehrt den zuvor sichtbaren manuellen Library-Prueftask getrennt aus."""
+    db = SessionLocal()
+    try:
+        task = db.query(SunoTask).filter(SunoTask.id == int(task_id)).first()
+        if not task:
+            return
+        await cache_missing_library_content_once(
+            db,
+            limit=min(5000, max(1, int(limit or 5000))),
+            notify_always=True,
+            background=False,
+            status_task=task,
+        )
+    except Exception as exc:
+        db.rollback()
+        task = db.query(SunoTask).filter(SunoTask.id == int(task_id)).first()
+        if task:
+            now = utc_now_naive()
+            message = f"Library-Inhalte konnten nicht geprüft werden: {exc}"
+            task.status = "FAILED"
+            task.completed_at = now
+            task.heartbeat_at = now
+            task.error_message = str(exc)[:2000]
+            response_payload = dict(task.response_payload or {})
+            response_payload.update({
+                "background": True,
+                "status": "FAILED",
+                "completed_at": now.isoformat(),
+            })
+            task.response_payload = response_payload
+            append_task_debug_event(
+                db,
+                task,
+                event="library_content_cache_failed",
+                detail=message,
+                level="error",
+                data={"limit": limit, "error": str(exc)},
+                commit=False,
+            )
+            append_task_step_log(
+                db,
+                task,
+                phase="failed",
+                phase_label="Library-Inhalte prüfen fehlgeschlagen",
+                detail=message,
+                data={"limit": limit},
+                commit=False,
+            )
+            db.add(StatusNotification(
+                event_type="library_content_cache_failed",
+                title="Library-Inhalte prüfen fehlgeschlagen",
+                message=message,
+                severity="error",
+                status="unread",
+                task_local_id=task.id,
+                suno_task_id=task.task_id,
+                content_type="system",
+                content_id=task.id,
+                target_tab="library",
+                target_payload={
+                    "task_local_id": task.id,
+                    "task_type": task.task_type,
+                    "status": "FAILED",
+                    "error": str(exc)[:1000],
+                },
+                completed_at=now,
+            ))
+            db.commit()
+        raise
+    finally:
+        db.close()
