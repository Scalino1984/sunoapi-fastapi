+def _canonical_suno_cover_from_removeai(value: Any) -> str | None:
+    """Mappt fehlerhafte RemoveAI-Bild-Proxies auf die originale Suno-CDN-URL.
+
+    SunoAPI.org-Resultate enthalten teils ``musicfile.removeai.ai/<base64>.jpeg``.
+    Der Host ist fuer Audio-Proxy-IDs ausgelegt und versucht beim Aufruf den
+    kompletten Dateinamen als Base64 zu dekodieren. Die Bildendung macht den
+    Token ungueltig ("Invalid Base64 encoding"). Der Base64-Stamm enthaelt
+    jedoch die Suno-UUID, aus der sich die bekannte originale Cover-URL
+    deterministisch rekonstruieren laesst.
+    """
+    if not isinstance(value, str):
+        return None
+    text = value.strip()
+    if not text:
+        return None
+    parsed = urlparse(text)
+    if (parsed.hostname or "").lower() != REMOVEAI_MEDIA_HOST:
+        return None
+    suffix = Path(parsed.path).suffix.lower()
+    if suffix not in REMOVEAI_IMAGE_EXTENSIONS:
+        return None
+    token = Path(parsed.path).stem.strip()
+    if not token:
+        return None
+    try:
+        padded = token + ("=" * (-len(token) % 4))
+        decoded = base64.urlsafe_b64decode(padded.encode("ascii")).decode("ascii").strip()
+        media_id = str(UUID(decoded))
+    except Exception:
+        return None
+    return f"https://cdn2.suno.ai/image_{media_id}.jpeg"
+
+
+def _repair_malformed_cover_reference(target: Any, attribute: str) -> bool:
+    current = getattr(target, attribute, None)
+    canonical = _canonical_suno_cover_from_removeai(current)
+    if not canonical or canonical == current:
+        return False
+    setattr(target, attribute, canonical)
+    return True
+
