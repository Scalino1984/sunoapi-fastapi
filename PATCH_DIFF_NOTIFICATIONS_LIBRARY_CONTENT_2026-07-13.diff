+        source_url="manual://cover-only",
+        image_url=broken,
+        status="remote",
+        metadata_json={"candidate": {"imageUrl": broken, "sourceImageUrl": canonical}},
+    )
+    db.add(asset)
+    db.commit()
+
+    attempted: list[str] = []
+
+    async def no_provider_backfill(self, *, limit=40):
+        return 0
+
+    async def unavailable_cover(self, target, image_url=None):
+        attempted.append(str(image_url or ""))
