+def test_known_cover_urls_replaces_invalid_removeai_image_proxy(isolated_db_session):
+    db = isolated_db_session
+    broken = "https://musicfile.removeai.ai/ZjlmODQ4MWMtMDk2ZS00Zjg1LWI3YmQtYjc2YzNiOGRhN2Q5.jpeg"
+    canonical = "https://cdn2.suno.ai/image_f9f8481c-096e-4f85-b7bd-b76c3b8da7d9.jpeg"
+    asset = AudioAsset(
+        source_url="https://cdn1.suno.ai/f9f8481c-096e-4f85-b7bd-b76c3b8da7d9.mp3",
+        image_url=broken,
+        status="remote",
+        metadata_json={
+            "candidate": {
+                "imageUrl": broken,
+                "sourceImageUrl": canonical,
+            }
+        },
+    )
+    db.add(asset)
+    db.commit()
+
+    urls = _known_cover_urls(db, asset)
+
+    assert _canonical_suno_cover_from_removeai(broken) == canonical
+    assert canonical in urls
+    assert broken not in urls
+    assert urls.count(canonical) == 1
+
+
